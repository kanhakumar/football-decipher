{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/insight.schema.json",
  "title": "Insight v1.0",
  "description": "The central contract between the engine, the agents and delivery. Language-neutral and persona-neutral: facts and a reason code, never prose. Narration is generated from this, never the other way around.",
  "type": "object",
  "required": ["insight_id", "match_id", "kind", "period", "t_match_s", "video_ts_ms", "teams", "facts", "evidence_event_ids", "why_it_matters", "importance", "basis", "capability_level", "created_at"],
  "additionalProperties": false,
  "properties": {
    "insight_id": { "type": "string", "pattern": "^I_[0-9]{1,6}$" },
    "match_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "kind": { "enum": ["goal", "red_card", "key_chance", "momentum_swing", "pressure_shift", "control_vs_chaos", "rhythm_change", "milestone", "player_spotlight", "tactical_shift"] },
    "period": { "type": "integer", "minimum": 1, "maximum": 5 },
    "t_match_s": { "type": "number", "minimum": 0 },
    "video_ts_ms": { "type": "integer", "minimum": 0 },
    "teams": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "pattern": "^T_[A-Z0-9_]{1,16}$" } },
    "players": { "type": "array", "items": { "type": "string", "pattern": "^P_[A-Z0-9_]{1,24}$" } },
    "facts": {
      "type": "object",
      "description": "Every number the narration may use. The Verifier checks generated text against this and the engine.",
      "minProperties": 1,
      "additionalProperties": { "type": ["number", "string", "boolean", "array"] }
    },
    "evidence_event_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^E_[0-9]{1,9}$" } },
    "why_it_matters": {
      "type": "object",
      "required": ["code", "params"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,60}$", "description": "Stable reason code, e.g. pressing_raises_chance_quality." },
        "params": { "type": "object" }
      }
    },
    "importance": { "type": "number", "minimum": 0, "maximum": 1 },
    "basis": { "enum": ["event_data", "tracking", "event_estimate"] },
    "capability_level": { "type": "integer", "minimum": 0, "maximum": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "retracted"], "default": "active" },
    "supersedes": { "type": "string", "pattern": "^I_[0-9]{1,6}$" }
  }
}
