{
  "description": "Known-bad variants of the examples. Each case mutates one example; the schema and every model decoder must reject the result. Used by schema/validate_examples.py and the Scala golden tests.",
  "cases": [
    { "name": "wrong schema_version", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["schema_version"], "value": "2.0" },
    { "name": "negative seq", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["seq"], "value": -1 },
    { "name": "unknown source", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["source"], "value": "vendor" },
    { "name": "missing payload", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "drop", "path": ["payload"] },
    { "name": "extra envelope field", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["extra"], "value": 1 },
    { "name": "bad emitted_at", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["emitted_at"], "value": "yesterday" },
    { "name": "bad event_id", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "event_id"], "value": "417" },
    { "name": "x beyond pitch", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "x"], "value": 105.5 },
    { "name": "y below pitch", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "y"], "value": -0.1 },
    { "name": "unknown event type", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "type"], "value": "teleport" },
    { "name": "pass without details", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "drop", "path": ["payload", "details"] },
    { "name": "pass with a shot outcome", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "outcome"], "value": "saved" },
    { "name": "unknown field in pass details", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "details", "xg"], "value": 0.1 },
    { "name": "pass end_x beyond pitch", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "create" }, "action": "set", "path": ["payload", "details", "end_x"], "value": 106 },
    { "name": "bad team_id", "file": "examples.ndjson", "match": { "payload_type": "lineup", "op": "create" }, "action": "set", "path": ["payload", "team_id"], "value": "home" },
    { "name": "ten starters", "file": "examples.ndjson", "match": { "payload_type": "lineup", "op": "create" }, "action": "drop", "path": ["payload", "starters", 0] },
    { "name": "shirt number 0", "file": "examples.ndjson", "match": { "payload_type": "lineup", "op": "create" }, "action": "set", "path": ["payload", "starters", 0, "shirt"], "value": 0 },
    { "name": "pitch too short", "file": "examples.ndjson", "match": { "payload_type": "match_meta", "op": "create" }, "action": "set", "path": ["payload", "pitch", "length_m"], "value": 80 },
    { "name": "unknown data_origin", "file": "examples.ndjson", "match": { "payload_type": "match_meta", "op": "create" }, "action": "set", "path": ["payload", "data_origin"], "value": "scraped" },
    { "name": "tracking hz zero", "file": "examples.ndjson", "match": { "payload_type": "tracking_frame", "op": "create" }, "action": "set", "path": ["payload", "hz"], "value": 0 },
    { "name": "tracking player too fast", "file": "examples.ndjson", "match": { "payload_type": "tracking_frame", "op": "create" }, "action": "set", "path": ["payload", "players", 0, "speed_ms"], "value": 14 },
    { "name": "extra field in delete", "file": "examples.ndjson", "match": { "payload_type": "event", "op": "delete" }, "action": "set", "path": ["payload", "type"], "value": "pass" },
    { "name": "bad insight_id", "file": "insight.example.json", "action": "set", "path": ["insight_id"], "value": "insight-42" },
    { "name": "unknown insight kind", "file": "insight.example.json", "action": "set", "path": ["kind"], "value": "vibes" },
    { "name": "importance above 1", "file": "insight.example.json", "action": "set", "path": ["importance"], "value": 1.5 },
    { "name": "empty facts", "file": "insight.example.json", "action": "set", "path": ["facts"], "value": {} },
    { "name": "no evidence", "file": "insight.example.json", "action": "set", "path": ["evidence_event_ids"], "value": [] },
    { "name": "duplicate evidence", "file": "insight.example.json", "action": "set", "path": ["evidence_event_ids"], "value": ["E_1", "E_1"] },
    { "name": "prose field in insight", "file": "insight.example.json", "action": "set", "path": ["text"], "value": "A great moment." },
    { "name": "capability level 3", "file": "insight.example.json", "action": "set", "path": ["capability_level"], "value": 3 },
    { "name": "unknown overlay op", "file": "overlay.example.json", "action": "set", "path": ["op"], "value": "hide" },
    { "name": "show overlay missing t_start_ms", "file": "overlay.example.json", "action": "drop", "path": ["t_start_ms"] },
    { "name": "show overlay missing content", "file": "overlay.example.json", "action": "drop", "path": ["content"] },
    { "name": "negative duration", "file": "overlay.example.json", "action": "set", "path": ["duration_ms"], "value": -1 },
    { "name": "bad basis", "file": "overlay.example.json", "action": "set", "path": ["basis"], "value": "guess" },
    { "name": "shape map with 12 positions", "file": "overlay-shape.example.json", "action": "set", "path": ["content", "positions"], "value": [{"player_id":"P_HOM_01","x":50,"y":34},{"player_id":"P_HOM_02","x":50,"y":34},{"player_id":"P_HOM_03","x":50,"y":34},{"player_id":"P_HOM_04","x":50,"y":34},{"player_id":"P_HOM_05","x":50,"y":34},{"player_id":"P_HOM_06","x":50,"y":34},{"player_id":"P_HOM_07","x":50,"y":34},{"player_id":"P_HOM_08","x":50,"y":34},{"player_id":"P_HOM_09","x":50,"y":34},{"player_id":"P_HOM_10","x":50,"y":34},{"player_id":"P_HOM_11","x":50,"y":34},{"player_id":"P_HOM_12","x":50,"y":34}] },
    { "name": "shape map position off the pitch", "file": "overlay-shape.example.json", "action": "set", "path": ["content", "positions", 0, "x"], "value": 120 }
  ]
}
